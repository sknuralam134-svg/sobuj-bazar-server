# PostgreSQL connection string (Railway/Render gives you this automatically
# when you add a Postgres plugin/service)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Random long secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Your deployed frontend URL(s), comma-separated if more than one
# (used for CORS and for building password-reset links)
FRONTEND_URL="https://sobujbazar.vercel.app"

# Port the server listens on (Railway/Render set this automatically; safe to leave)
PORT=4000

# SMTP settings for sending OTP + password-reset emails.
# Any provider works (Gmail app password, Resend, Brevo, SendGrid SMTP, etc.)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="সবুজ বাজার <no-reply@sobujbazar.com>"

# Optional: used only by `npm run seed` to create the first admin account
SEED_ADMIN_EMAIL="admin@sobujbazar.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
