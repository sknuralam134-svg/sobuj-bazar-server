# PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

JWT_SECRET="replace-with-a-long-random-string"
FRONTEND_URL="https://sobujbazar.vercel.app"
PORT=4000

# Email (Resend recommended)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="resend"
SMTP_PASS="re_xxxxxxxx"
SMTP_FROM="সবুজ বাজার <onboarding@resend.dev>"

# Firebase Admin (Phone Auth) — from Firebase Console → Project settings → Service accounts
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# Paste private key with \n for newlines, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

SEED_ADMIN_EMAIL="admin@sobujbazar.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Cloudflare R2 (product image uploads) — https://dash.cloudflare.com → R2
# Create a bucket, enable public access (or custom domain), then create an API token with Object Read & Write.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="sobuj-bazar-images"
# Public base URL of the bucket (no trailing slash). Examples:
#   https://pub-xxxxxxxx.r2.dev
#   or your custom domain e.g. https://images.sobujbazar.com
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
