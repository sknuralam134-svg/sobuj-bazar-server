# PostgreSQL connection string (Railway/Render gives you this automatically
# when you add a Postgres plugin/service)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Random long secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Your deployed frontend URL(s), comma-separated if more than one
# (used for CORS and for building password-reset links)
FRONTEND_URL="https://sobujbazar.vercel.app"

# Port the server listens on (Railway/Render set this automatically; safe to leave)
PORT=4000

# --- Email (recommended: Resend) ---
# Option A — Resend HTTP API (most reliable on Render free tier):
#   Set SMTP_HOST=smtp.resend.com and SMTP_PASS=re_xxxx (your API key)
#   OR set RESEND_API_KEY=re_xxxx
# Option B — any SMTP (Gmail app password, Brevo, etc.)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="resend"
SMTP_PASS="re_xxxxxxxx"
SMTP_FROM="সবুজ বাজার <onboarding@resend.dev>"
# Optional explicit Resend key (overrides SMTP_PASS for API path if set)
# RESEND_API_KEY="re_xxxxxxxx"

# Optional: used only by `npm run seed` to create the first admin account
SEED_ADMIN_EMAIL="admin@sobujbazar.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
